[node name="Label2" type="Label" parent="HUD/Game_start/MarginContainer/VBoxContainer/HBoxContainer2"]
layout_mode = 2
theme_override_font_sizes/font_size = 20
text = "                         Easy:
A calm and forgiving market
 with no unexpected expenses. 
Crashes are rare and mild, 
and volatility is very low 
 perfect for relaxed 
gameplay or beginners.
"

[node name="Label3" type="Label" parent="HUD/Game_start/MarginContainer/VBoxContainer/HBoxContainer2"]
layout_mode = 2
theme_override_font_sizes/font_size = 20
text = "Normal:
A balanced economy
 with occasional small unexpected expenses.
 Crashes are 
more frequent, but manageable.
 Ideal for players 
who want a fair challenge."

[node name="Label4" type="Label" parent="HUD/Game_start/MarginContainer/VBoxContainer/HBoxContainer2"]
layout_mode = 2
theme_override_font_sizes/font_size = 20
text = "Hard:
A harsh market with regular unexpected
 expenses and higher volatility. 
Crashes come often and hit harder  
strategic planning is a must."

[node name="Label5" type="Label" parent="HUD/Game_start/MarginContainer/VBoxContainer/HBoxContainer2"]
layout_mode = 2
theme_override_font_sizes/font_size = 20
text = "Nightmare:
Pure financial chaos.
 Crashes are severe and frequent, 
volatility is extreme, 
and unexpected expenses are constant. 
For experienced players only."

