[rendering]

rendering_device/vsync/frame_queue_size=3
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=0
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=0
anti_aliasing/quality/msaa_3d=1
textures/light_projectors/filter=0
limits/opengl/max_renderable_lights=256
limits/opengl/max_lights_per_object=1024
lights_and_shadows/positional_shadow/atlas_size=8192
vsync/use_vsync=false
environment/glow/enabled=true

[terraBrush]

brushes/decal_color=Color(0.878906, 0.845245, 0.0171661, 0.5)
